<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>SysMonitor</RootNamespace>
    <AssemblyName>sysmonitor</AssemblyName>

    <!-- Native AOT 发布配置 -->
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- 针对 ARM64 跨架构编译时关闭 Native AOT，采用纯原生 SingleFile -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- 排除 tools 目录中的辅助编译脚本，避免产生多入口冲突 CS0017 -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Include="tools/**" />
  </ItemGroup>

  <!-- Linux 平台：仅编译 Linux 原生引擎与平台通用逻辑，排除 Windows 专有 WPF 代码 (使用标准正斜杠兼容 Linux MSBuild) -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="src/MainWindow.cs" />
    <Compile Remove="src/DetailWindow.cs" />
    <Compile Remove="src/ToastNotification.cs" />
    <Compile Remove="src/AppTheme.cs" />
    <Compile Remove="src/Monitors.cs" />
    <Compile Remove="src/Program.cs" />
    <Compile Remove="src/Models.cs" />
    <Compile Remove="src/MemberDirectory.cs" />
    <Compile Remove="src/AppSettings.cs" />
    <Compile Remove="src/FlagAssets.cs" />
  </ItemGroup>

  <!-- Windows 平台：排除 Linux 专用驱动与 Linux 入口 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="src/Linux/**" />
  </ItemGroup>

  <!-- 包含多分辨率图标和桌面配置 -->
  <ItemGroup>
    <Content Include="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts/sysmonitor.desktop">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
