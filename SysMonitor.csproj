<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>SysMonitor</RootNamespace>
    <AssemblyName>sysmonitor</AssemblyName>

    <!-- 彻底关闭 SDK 默认的通配源码包含，按平台严格精准包含，根治跨平台源码交叉污染 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- Linux x64 默认使用 Native AOT -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
  </PropertyGroup>

  <!-- Linux ARM64 跨架构编译使用 SingleFile 自包含 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- Linux 平台：仅编译 Linux 原生引擎，完全隔离 Windows WPF 专有代码 -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Include="src/Linux/*.cs" />
  </ItemGroup>

  <!-- Windows 平台：编译 Windows 源码 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Include="src/*.cs" />
  </ItemGroup>

  <!-- 包含多分辨率图标和桌面配置 -->
  <ItemGroup>
    <Content Include="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="scripts/sysmonitor.desktop">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
